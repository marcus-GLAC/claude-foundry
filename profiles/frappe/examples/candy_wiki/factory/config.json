		},
		"claude-sonnet-5-5": {
			"input": 2.0,
			"output": 10.0,
			"cache_write_5m": 2.5,
			"cache_write_1h": 4.0,
			"cache_read": 0.2
		},
		"claude-haiku-5-5": {
			"input": 0.1,
			"output": 0.5,
			"cache_write_5m": 0.125,
			"cache_write_1h": 0.2,
