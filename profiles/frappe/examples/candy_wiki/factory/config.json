{
	"concurrency": 1,
	"max_rounds": 3,
	"base_branch": "version-16",
	"language": "Vietnamese",
	"merge_method": "merge",
	"worktree_path": "/home/marcus/frappe_docker/development/.factory-sandboxes/candy_wiki/{job}/apps/candy_wiki",
	"on_finish": ["python3 factory/bin/frappe-sandbox drop {job}"],
	"labels": {
		"queue": "factory",
		"needs_info": "factory:needs-info",
		"needs_human": "factory:needs-human"
	},
	"routing": {
		"low": {
			"code": "sonnet"
		},
		"medium": {
			"code": "sonnet"
		},
		"high": {
			"code": "opus"
		}
	},
	"surface_reviewers": {
		"ui": {
			"ux": "sonnet",
			"ui": "sonnet"
		},
		"security": {
			"security": "opus"
		}
	},
	"protected_paths": [
		"factory/*",
		"scripts/ci.sh",
		"scripts/semgrep_gate.py",
		".semgrep/*",
		"biome.json",
		".pre-commit-config.yaml",
		"commitlint.config.js"
	],
	"ports": {
		"base": 5100,
		"step": 10
	},
